APP_ENV=dev
APP_DEBUG=1
APP_SECRET=isolated-validation-not-for-production
APP_SHARE_DIR=/var/www/var/share
DEFAULT_URI=http://localhost
DATABASE_URL=postgresql://validation:validation@hub-validation-db:5432/hub_validation?serverVersion=16&charset=utf8
MESSENGER_EMAIL_TRANSPORT_DSN=in-memory://
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=validation
